{
  "name": "hitl-workflow-router",
  "version": "1.0.0",
  "description": "Lightweight workflow router for AI agent actions with policy-driven routing and human-in-the-loop approvals",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "hitl-router": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "human-in-the-loop",
    "workflow-router",
    "agentic-ai",
    "policy-engine",
    "audit"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
